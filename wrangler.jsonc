{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-long-silence",
  "compatibility_date": "2026-07-25",

  // A pure static-asset Worker: there is no server-side code, so there is no
  // "main" entry. Vite emits the whole game into dist/, including everything
  // from public/ (icons, manifest, the embed image).
  "assets": {
    "directory": "./dist"
  },

  // custom_domain makes Cloudflare create and manage the DNS record for the
  // hostname itself, rather than needing a separate record + route.
  "routes": [
    { "pattern": "longsilence.anshu.dev", "custom_domain": true }
  ],

  "observability": {
    "enabled": true
  }
}
